{
  "name": "educonnect-root",
  "version": "1.0.0",
  "scripts": {
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:selenium": "npm install --prefix selenium-tests",
    "install:appium": "npm install --prefix appium-tests",
    "install:vulnerability": "npm install --prefix vulnerability-tests",
    "install:load": "npm install --prefix load-tests",
    "install-all": "npm run install:backend && npm run install:frontend && npm run install:selenium && npm run install:appium && npm run install:vulnerability && npm run install:load",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test:selenium": "npm run test --prefix selenium-tests",
    "test:appium": "npm run test --prefix appium-tests",
    "test:vulnerability": "npm run test --prefix vulnerability-tests",
    "test:load": "npm run test --prefix load-tests",
    "report:selenium": "npm run generate-report --prefix selenium-tests",
    "report:appium": "npm run generate-report --prefix appium-tests",
    "report:vulnerability": "npm run generate-report --prefix vulnerability-tests",
    "report:load": "npm run generate-report --prefix load-tests"
  }
}
